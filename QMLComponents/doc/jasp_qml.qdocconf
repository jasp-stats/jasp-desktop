project = JASP-QML
description = JASP QML Components Reference
version = 1.0

# -- Input Settings --
# Point to the source code containing the /*! comments */
sourcedirs = c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls \
             c:/JASP-Packages/jasp-desktop/QMLComponents/doc
headerdirs = c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls
imagedirs  = ./images

# Tell qdoc to parse QML files - use correct syntax
sources.fileextensions = *.qml *.qdoc
headers.fileextensions = *.h

# -- Exclude internal-only UI controls --
# These components are used internally by the JASP framework
# and should not appear in the module developer documentation.
excludefiles += c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/ALTNavTag.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/CrossButton.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/JASPScrollBar.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/MenuButton.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/HelpButton.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/RoundedButton.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/RectangularButton.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/ScrollMoreIndicator.qml \
                c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP/Controls/SortMenuButton.qml

# -- QML Module Configuration --
# Point to the directory containing qmldir (parent of Controls)
qmlimportpath = c:/JASP-Packages/jasp-desktop/QMLComponents/components/JASP

# -- Output Settings --
outputdir  = ./html_out
outputformats = HTML

# -- Module Registration --
qhp.projects = JASP
qhp.JASP.file = jasp.qhp
qhp.JASP.namespace = org.jasp-stats.qml.1.0
qhp.JASP.virtualFolder = jasp
qhp.JASP.indexTitle = JASP QML Controls
qhp.JASP.indexRoot =

# -- HTML Styling --
HTML.stylesheets = style.css
HTML.headerstyles = "<link rel='stylesheet' type='text/css' href='style/style.css'/>"
