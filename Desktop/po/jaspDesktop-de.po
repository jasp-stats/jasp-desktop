msgctxt "PrefsAdvanced|"
msgid ""
"Continue where you left of the next time JASP starts.\n"
"Enabling this option makes JASP remember which Modules you've enabled."
msgstr ""
"Beim nächsten Start von JASP weitermachen, wo Sie aufgehört haben.\n"
"Durch Aktivieren dieser Option behält sich JASP, welche Module Sie aktiviert "
"haben."

msgctxt "PrefsAdvanced|"
msgid "To use JASP Modules enable this option."
msgstr "Diese Option aktivieren, um JASP-Module zu verwenden."

msgctxt "PrefsAdvanced|"
msgid "Browse to your JASP Module folder."
msgstr "Zum JASP-Moduleverzeichnis gehen."

