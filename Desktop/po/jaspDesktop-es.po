msgctxt "PrefsAdvanced|"
msgid ""
"Continue where you left of the next time JASP starts.\n"
"Enabling this option makes JASP remember which Modules you've enabled."
msgstr ""
"La próxima vez que se inicie JASP, continuar donde se dejó .\n"
"Activar esta opción hace que JASP recuerde qué Módulos estaban habilitados."

msgctxt "PrefsAdvanced|"
msgid "To use JASP Modules enable this option."
msgstr "Habilitar esta opción para utilizar los Módulos de JASP."

msgctxt "PrefsAdvanced|"
msgid "Browse to your JASP Module folder."
msgstr "Navegar hasta la carpeta de Módulos de JASP."

msgctxt "PrefsAdvanced|"
