msgstr "Generar archivos reducidos para la ayuda"

msgctxt "PrefsAdvanced|"
msgid ""
"Enabling this will generate markdown helpfile from the info at qml options."
msgstr ""
"Habilitar esto generará un archivo de ayuda reducido a partir de la "
"información sobre las opciones qml."

msgctxt "PrefsAdvanced|"
