msgid "Image background color"
msgstr "Kép háttérszín"

msgctxt "PrefsResults|"
msgid "White"
msgstr "Fehér"

msgctxt "PrefsResults|"
msgid "This makes the background of all plots white, quite useful if you want to use it in LaTeX or submit it to a journal."
msgstr "Az összes diagram hátterét fehérre állítja, ami hasznos lehet, ha LaTeX kódban akarod használni, vagy egy folyóiratnak beküldeni."

msgctxt "PrefsResults|"
msgid "Transparent"
msgstr "Átlátszó"

msgctxt "PrefsResults|"
msgid "This makes the background of all plots transparent, quite useful if you want to use it seamlessly on any background that isn't white."
msgstr "Az összes diagram hátterét átlátszóra állítja, ami hasznos lehet, ha nem fehér színű háttér előtt akarod használni."

msgctxt "PrefsUI|"
msgid "Fonts"
msgstr "Betűtípusok"

