msgctxt "PrefsAdvanced|"
msgid "Advanced Preferences"
msgstr "Hobespen Aurreratuak"

msgctxt "PrefsAdvanced|"
msgid "Modules options"
msgstr "Moduluen aukerak"

msgctxt "PrefsAdvanced|"
msgid ""
"Continue where you left of the next time JASP starts.\n"
"Enabling this option makes JASP remember which Modules you've enabled."
msgstr ""
"Jarraitu utzi zenuen tokitik hurrengoan JASP abiarazten denean.\n"
"Aukera hau gaitzeak JASP-ek zein modulu gaitu dituzun gogorarazten dio."

msgctxt "PrefsAdvanced|"
msgid "To use JASP Modules enable this option."
msgstr "JASP moduluak erabiltzeko, gaitu aukera hau."

msgctxt "PrefsAdvanced|"
msgid "Browse to your JASP Module folder."
msgstr "Arakatu zure JASP Moduluen karpetara."

msgctxt "PrefsAdvanced|"
msgid "Change the CRAN repository: "
msgstr "Aldatu CRAN biltegia: "

msgctxt "PrefsAdvanced|"
msgid "Generate markdown files for help"
msgstr "Sortu markdown fitxategiak laguntzarako"

msgctxt "PrefsAdvanced|"
msgid ""
"Enabling this will generate markdown helpfile from the info at qml options."
msgstr ""
"Hau gaitzeak markdown laguntza fitxategia sortuko du qml aukeretako "
"informaziotik."

msgctxt "PrefsAdvanced|"
msgid "Logging options"
msgstr "Erregistro aukerak"

msgctxt "PrefsAdvanced|"
msgid "Log to file"
msgstr "Erregistratu fitxategian"

msgctxt "PrefsAdvanced|"
msgid "To store debug-logs of JASP in a file, check this box."
msgstr ""
"JASP-ren arazketa-erregistroak fitxategi batean gordetzeko, markatu laukitxo "
"hau."

msgctxt "PrefsAdvanced|"
msgid "Max logfiles to keep: "
msgstr "Gordetzeko gehienezko erregistro fitxategi kopurua: "

msgctxt "PrefsAdvanced|"
msgid "Show logs"
msgstr "Erakutsi erregistroak"

msgctxt "PrefsAdvanced|"
msgid "Engine options"
msgstr "Motorraren aukerak"

