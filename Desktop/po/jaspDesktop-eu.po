msgstr "y-ko elementu kopurua itzultzen du"

msgctxt "ComputeColumnWindow|"
msgid "median"
msgstr "mediana"

msgctxt "ComputeColumnWindow|"
msgid "natural logarithm"
msgstr "logaritmo naturala"

msgctxt "ComputeColumnWindow|"
msgid "base 2 logarithm"
msgstr "2 oinarriko logaritmoa"

msgctxt "ComputeColumnWindow|"
msgid "base 10 logarithm"
msgstr "10 oinarriko logaritmoa"

msgctxt "ComputeColumnWindow|"
msgid "logarithm of y in 'base'"
msgstr "'base'-ko y-ren logaritmoa"

msgctxt "ComputeColumnWindow|"
msgid "exponential"
msgstr "esponentziala"

msgctxt "ComputeColumnWindow|"
msgid ""
"Fisher's Z-transform (i.e., the inverse hyperbolic tangent) to transform "
"correlations, numbers between -1 and 1 to the real line"
msgstr ""
"Fisherren Z-transformazioa (hau da, alderantzizko tanjente hiperbolikoa) "
"korrelazioak eraldatzeko, -1 eta 1 arteko zenbakiak, lerro errealera"

msgctxt "ComputeColumnWindow|"
msgid ""
"Inverse Fisher's Z-transform (i.e., the hyperbolic tangent) to transform "
"real numbers to numbers between -1 and 1"
msgstr ""
"Alderantzizko Fisherren Z-transformazioa (hau da, tanjente hiperbolikoa) "
"zenbaki errealak -1 eta 1 arteko zenbakietara eraldatzeko"

msgctxt "ComputeColumnWindow|"
msgid "break your data up in numBreaks levels"
msgstr "zure datuak numBreaks mailetan banatu"

msgctxt "ComputeColumnWindow|"
msgid "replace any missing values (NA) in column by the value in replaceWith"
msgstr ""
"zutabean falta diren balioak (FB) ordezkatu replaceWith-eko balioarekin"

msgctxt "ComputeColumnWindow|"
msgid "if-else statement"
msgstr "if-else adierazpena"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Gaussian distribution with specified mean and standard "
"deviation sd"
msgstr ""
"datuak sortzen ditu banaketa gaussiar batetik, zehaztutako batez "
"bestekoarekin eta desbideratze estandarrarekin"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from t distribution with degrees of freedom df and non-"
"centrality parameter ncp"
msgstr ""
"t banaketatik datuak sortzen ditu ag askatasun-graduekin eta zentraltasun "
"eza parametro ncp-rekin"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a chi-squared distribution with degrees of freedom df "
"and non-centrality parameter ncp"
msgstr ""
"khi-karratu banaketa batetik datuak sortzen ditu ag askatasun-gradu eta "
"zentraltasun eza parametro ncp-rekin"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from an F distribution with specified degrees of freedoms "
"df1, df2 and non-centrality parameter ncp"
msgstr ""
"F banaketa batetik datuak sortzen ditu askatasun-gradu df1, df2 eta "
"zentraltasun eza parametro ncp-rekin"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a binomial distribution with specified trials and "
"probability prob"
msgstr ""
"banaketa binomial batetik datuak sortzen ditu saiakuntza eta probabilitate "
"prob zehaztuekin"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a negative binomial distribution with specified trials "
"and probability prob"
msgstr ""
"banaketa binomial negatibo batetik datuak sortzen ditu saiakuntza eta "
"probabilitate prob zehaztuekin"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a geometric distribution with specified probability prob"
msgstr ""
"banaketa geometriko batetik datuak sortzen ditu probabilitate prob zehaztu "
"batekin"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a Poisson distribution with specified rate lambda"
msgstr ""
"Poisson banaketa batetik datuak sortzen ditu lambda tasa zehaztu batekin"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a beta distribution with specified shapes alpha and beta"
msgstr "beta forma zehaztuekin beta banaketa batetik datuak sortzen ditu"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a uniform distribution between min and max"
msgstr "min eta max arteko banaketa uniforme batetik datuak sortzen ditu"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a gamma distribution with specified shape and scale"
msgstr ""
"forma eta eskala zehatzak dituen gamma banaketa batetik datuak sortzen ditu"

msgctxt "ComputeColumnWindow|"
msgid "generates data from an exponential distribution with specified rate"
msgstr "tasa zehatza duen banaketa esponentzial batetik datuak sortzen ditu"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a log-normal distribution with specified logarithmic "
"mean meanLog and standard deviation sdLog"
msgstr ""
"banaketa log-normal batetik datuak sortzen ditu, zehaztua duen batez besteko "
"logaritmikoa, meanLog eta desbideratze estandarra sdLog"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Weibull distribution with specified shape and scale"
msgstr ""
"forma eta eskala zehatzak dituen Weibull banaketa batetik datuak sortzen ditu"

