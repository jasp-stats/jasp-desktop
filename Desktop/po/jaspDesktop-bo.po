#, fuzzy
msgctxt "ComputedColumnsConstructor|"
msgid "Only one formula per computed column allowed."
msgstr "རྩིས་རྒྱག་བྱས་པའི་ཀ་ཐིག་རེར་སྤྱི་འགྲོས་རེ་ལས་མི་ཆོག"

msgctxt "ComputedColumnsConstructor|"
