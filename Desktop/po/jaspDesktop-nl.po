"vervangMet"

msgctxt "ComputeColumnWindow|"
msgid "if-else statement"
msgstr "if-else statement"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Gaussian distribution with specified mean and standard "
"deviation sd"
msgstr ""
"genereert gegevens van een Gauss verdeling met gespecificeerd gemiddelde en "
"standaard deviatie"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from t distribution with degrees of freedom df and non-"
"centrality parameter ncp"
msgstr ""
"genereert gegevens van een t-verdeling met gespecificeerd aantal "
"vrijheidsgraden vg en niet-centrale parameter ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a chi-squared distribution with degrees of freedom df "
"and non-centrality parameter ncp"
msgstr ""
"genereert data met een chi-kwadraat verdeling met vrijheidsgraden vg en niet-"
"centraliteitsparameter ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from an F distribution with specified degrees of freedoms "
"df1, df2 and non-centrality parameter ncp"
msgstr ""
"genereert data met een F verdeling met een gespecificeerd aantal "
"vrijheidsgraden vg 1, vg 2 en niet-centraliteitsparameter ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a binomial distribution with specified trials and "
"probability prob"
msgstr ""
"genereert data met een binomiaalverdeling met gespecificeerde steekproeven "
"en kans"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a negative binomial distribution with specified trials "
"and probability prob"
msgstr ""
"genereert data met een negatieve binomiaalverdeling met gespecificeerde "
"steekproeven en kans"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a geometric distribution with specified probability prob"
msgstr ""
"genereert data met een geometrische verdeling met gespecificeerde kans prob"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a Poisson distribution with specified rate lambda"
msgstr "genereert gegevens uit een Poisson-verdeling met gespecificeerde lambda-snelheid"
"genereert data met een Poissonverdeling met een gespecificeerde snelheid/ "
"intensiteit lambda"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a beta distribution with specified shapes alpha and beta"
msgstr ""
"genereert data met een betaverdeling met gespecificeerde vormen alpha en beta"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a uniform distribution between min and max"
msgstr "genereert data met een uniforme verdeling tussen min en max"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a gamma distribution with specified shape and scale"
msgstr "genereert gegevens uit een gamma-verdeling met gespecificeerde vorm en schaal"
"genereert data met een gammaverdeling met gespecificeerde vorm en schaal"

msgctxt "ComputeColumnWindow|"
msgid "generates data from an exponential distribution with specified rate"
msgstr "genereert gegevens uit een exponentiële verdeling met gespecificeerde snelheid"
"genereert data met een exponentiële verdeling met een gespecificeerde "
"snelheid/ intensiteit"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a log-normal distribution with specified logarithmic "
"mean meanLog and standard deviation sdLog"
msgstr ""
"genereert data met een log-normaalverdeling met een gespecificeerd "
"logaritmisch gemiddelde meanLog en standaardafwijking sdLog"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Weibull distribution with specified shape and scale"
msgstr ""
"genereert data met een Weibullverdeling met gespecificeerde vorm en schaal"

