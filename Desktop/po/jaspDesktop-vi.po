msgid "Bayes Factor"
msgstr "Yếu tố Bayes"

msgctxt "BayesFactorType|"
msgid ""
"Bayes factor to quantify evidence for the alternative hypothesis relative to "
"the null hypothesis."
msgstr ""
"Hệ số Bayes dùng để định lượng bằng chứng ủng hộ giả thuyết thay thế so với "
"giả thuyết không."

msgctxt "BayesFactorType|"
