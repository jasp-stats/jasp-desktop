msgctxt "PrefsAdvanced|"
msgid ""
"Continue where you left of the next time JASP starts.\n"
"Enabling this option makes JASP remember which Modules you've enabled."
msgstr ""
"Tiếp tục từ vị trí đã dừng ở lần khởi động JASP tiếp theo.\n"
"Bật tùy chọn này để JASP ghi nhớ các mô-đun đã được kích hoạt."

msgctxt "PrefsAdvanced|"
msgid "To use JASP Modules enable this option."
msgstr "Bạt tùy chọn này để sử dụng các mô-đun JASP."

msgctxt "PrefsAdvanced|"
msgid "Browse to your JASP Module folder."
msgstr "Chọn thư mục mô-đun JASP."

msgctxt "PrefsAdvanced|"
msgid "Change the CRAN repository: "
msgstr "Thay đổi kho lưu trữ CRAN: "

msgctxt "PrefsAdvanced|"
msgid "Generate markdown files for help"
msgstr "Tạo tệp Markdown để được trợ giúp"

msgctxt "PrefsAdvanced|"
msgid ""
"Enabling this will generate markdown helpfile from the info at qml options."
msgstr ""
"Việc kích hoạt tùy chọn này sẽ tạo ra tệp trợ giúp Markdown từ thông tin "
"trong các tùy chọn qml."

msgctxt "PrefsAdvanced|"
msgid "Logging options"
msgstr "Tùy chọn ghi nhật ký"

msgctxt "PrefsAdvanced|"
msgid "Log to file"
msgstr "Ghi nhật ký vào tệp tin"

msgctxt "PrefsAdvanced|"
msgid "To store debug-logs of JASP in a file, check this box."
msgstr "Để lưu nhật ký gỡ lỗi của JASP vào một tệp, hãy chọn ô này."

msgctxt "PrefsAdvanced|"
msgid "Max logfiles to keep: "
msgstr "Số lượng tập tin nhật ký tối đa được giữ lại: "

msgctxt "PrefsAdvanced|"
msgid "Show logs"
msgstr "Hiển thị nhật ký"

msgctxt "PrefsAdvanced|"
