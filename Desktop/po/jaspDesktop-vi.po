msgctxt "ComputeColumnWindow|"
msgid "summation"
msgstr "phép tổng"

msgctxt "ComputeColumnWindow|"
msgid "product of values"
msgstr "tích các giá trị"

msgctxt "ComputeColumnWindow|"
msgid "returns minimum of values"
msgstr "trả về giá trị nhỏ nhất"

msgctxt "ComputeColumnWindow|"
