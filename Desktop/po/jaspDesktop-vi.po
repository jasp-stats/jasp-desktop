msgstr "trả về giá trị lớn nhất"

msgctxt "ComputeColumnWindow|"
msgid "mean"
msgstr "trung bình"

msgctxt "ComputeColumnWindow|"
msgid "rounds y to n decimals"
msgstr "làm tròn y đến n chữ số thập phân"

msgctxt "ComputeColumnWindow|"
msgid "returns number of elements in y"
msgstr "trả về số phần tử của y"

msgctxt "ComputeColumnWindow|"
msgid "median"
msgstr "trung vị"

msgctxt "ComputeColumnWindow|"
msgid "natural logarithm"
msgstr "logarit tự nhiên"

msgctxt "ComputeColumnWindow|"
msgid "base 2 logarithm"
msgstr "logarit cơ số 2"

msgctxt "ComputeColumnWindow|"
msgid "base 10 logarithm"
msgstr "logarit cơ số 10"

msgctxt "ComputeColumnWindow|"
msgid "logarithm of y in 'base'"
msgstr "logarit của y theo cơ số 'base'"

msgctxt "ComputeColumnWindow|"
msgid "exponential"
msgstr "hàm mũ"

msgctxt "ComputeColumnWindow|"
msgid ""
"Fisher's Z-transform (i.e., the inverse hyperbolic tangent) to transform "
"correlations, numbers between -1 and 1 to the real line"
msgstr ""
"Biến đổi Z của Fisher (tức là nghịch đảo hyperbolic tangent) để chuyển hệ số "
"tương quan (từ −1 đến 1) sang trục số thực"

msgctxt "ComputeColumnWindow|"
msgid ""
"Inverse Fisher's Z-transform (i.e., the hyperbolic tangent) to transform "
"real numbers to numbers between -1 and 1"
msgstr ""
"Biến đổi Z của Fisher (tức là nghịch đảo hyperbolic tangent) để chuyển hệ số "
"tương quan (từ −1 đến 1) sang trục số thực"

msgctxt "ComputeColumnWindow|"
msgid "break your data up in numBreaks levels"
msgstr "Chia dữ liệu thành các mức numBreaks"

msgctxt "ComputeColumnWindow|"
msgid "replace any missing values (NA) in column by the value in replaceWith"
msgstr "thay thế mọi giá trị thiếu (NA) trong cột bằng giá trị replaceWith"

msgctxt "ComputeColumnWindow|"
msgid "if-else statement"
msgstr "câu lệch if-else"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Gaussian distribution with specified mean and standard "
"deviation sd"
msgstr ""
"tạo dữ liệu từ phân phối Gaussian với trung bình và độ lệch chuẩn sd xác định"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from t distribution with degrees of freedom df and non-"
"centrality parameter ncp"
msgstr ""
"tạo dữ liệu từ phân phối t với bậc tự do df và tham số không trung tâm ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a chi-squared distribution with degrees of freedom df "
"and non-centrality parameter ncp"
msgstr ""
"tạo dữ liệu từ phân phối chi-bình phương với bậc tự do df và tham số không "
"trung tâm ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from an F distribution with specified degrees of freedoms "
"df1, df2 and non-centrality parameter ncp"
msgstr ""
"tạo dữ liệu từ phân phối F với bậc tự do df1, df2 và tham số không trung tâm "
"ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a binomial distribution with specified trials and "
"probability prob"
msgstr ""
"tạo dữ liệu từ phân phối nhị thức với số phép thử và xác suất prob xác định"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a negative binomial distribution with specified trials "
"and probability prob"
msgstr ""
"tạo dữ liệu từ phân phối nhị thức âm với số phép thử và xác suất prob xác "
"định"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a geometric distribution with specified probability prob"
msgstr "tạo dữ liệu từ phân phối hình học với xác suất prob xác định"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a Poisson distribution with specified rate lambda"
msgstr "tạo dữ liệu từ phân phối Poisson với tốc độ lambda xác định"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a beta distribution with specified shapes alpha and beta"
msgstr ""
"tạo dữ liệu từ phân phối beta với các tham số dạng alpha và beta xác định"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a uniform distribution between min and max"
msgstr "tạo dữ liệu từ phân phối đều trong khoảng từ min đến max"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a gamma distribution with specified shape and scale"
msgstr ""
"tạo dữ liệu từ phân phối gamma với tham số dạng (shape) và tỷ lệ (scale) xác "
"định"

msgctxt "ComputeColumnWindow|"
msgid "generates data from an exponential distribution with specified rate"
msgstr "tạo dữ liệu từ phân phối mũ với tốc độ (rate) xác định"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a log-normal distribution with specified logarithmic "
"mean meanLog and standard deviation sdLog"
msgstr ""
"tạo dữ liệu từ phân phối log-chuẩn với trung bình log meanLog và độ lệch "
"chuẩn sdLog xác định"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Weibull distribution with specified shape and scale"
msgstr ""
"tạo dữ liệu từ phân phối Weibull với tham số dạng (shape) và tỷ lệ (scale) "
"xác định"

