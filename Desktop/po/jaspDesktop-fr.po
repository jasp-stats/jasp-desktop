msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Gaussian distribution with specified mean and standard "
"deviation sd"
msgstr ""
"génère des données à partir d'une distribution gaussienne en spécifiant une "
"moyenne et un écart type"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from t distribution with degrees of freedom df and non-"
"centrality parameter ncp"
msgstr ""
"génère des données à partir de la distribution t avec des degrés de liberté "
"df et un paramètre de non-centralité ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a chi-squared distribution with degrees of freedom df "
"and non-centrality parameter ncp"
msgstr ""
"génère des données à partir d’une distribution du Khi-deux avec des degrés "
"de liberté df et un paramètre de non-centralité ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from an F distribution with specified degrees of freedoms "
"df1, df2 and non-centrality parameter ncp"
msgstr ""
"génère des données à partir d'une distribution F avec des degrés de liberté "
"spécifiés df1, df2 et le paramètre de non centralité ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a binomial distribution with specified trials and "
"probability prob"
msgstr ""
"génère des données à partir d'une distribution binomiale avec des essais et "
"probabilités spécifiés"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a negative binomial distribution with specified trials "
"and probability prob"
msgstr ""
"génère des données à partir d'une distribution binomiale négative avec des "
"essais et probabilités spécifiés"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a geometric distribution with specified probability prob"
msgstr ""
"génère des données à partir d'une distribution géométrique avec des "
"probabilités spécifiées"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a Poisson distribution with specified rate lambda"
msgstr "génère des données à partir d'une distribution de Poisson avec un taux lambda spécifié"
"génère des données à partir d'une distribution de Poisson avec un taux "
"lambda spécifié"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a beta distribution with specified shapes alpha and beta"
msgstr ""
"génère des données à partir d'une distribution bêta avec des formes alpha et "
"bêta spécifiées"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a uniform distribution between min and max"
msgstr "génère des données à partir d'une distribution uniforme entre min et max"
"génère des données à partir d'une distribution uniforme entre min et max"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a gamma distribution with specified shape and scale"
msgstr "génère des données à partir d'une distribution gamma avec forme et échelle spécifiées"
"génère des données à partir d'une distribution Weibull avec une forme et une "
"échelle spécifiées"

msgctxt "ComputeColumnWindow|"
msgid "generates data from an exponential distribution with specified rate"
msgstr "génère des données à partir d'une distribution exponentielle avec un taux spécifié"
"génère des données à partir d'une distribution exponentielle avec un taux "
"spécifié"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a log-normal distribution with specified logarithmic "
"mean meanLog and standard deviation sdLog"
msgstr ""
"génère des données à partir d'une distribution log-normale avec une moyenne "
"logarithmique spécifiée meanLog et un écart type sdLog"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Weibull distribution with specified shape and scale"
msgstr ""
"génère des données à partir d'une distribution Weibull avec une forme et une "
"échelle spécifiées"

