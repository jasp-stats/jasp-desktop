msgid "natural logarithm"
msgstr "logarytm naturalny"

msgctxt "ComputeColumnWindow|"
msgid "base 2 logarithm"
msgstr "logarytm o podstawie 2"

msgctxt "ComputeColumnWindow|"
msgid "base 10 logarithm"
msgstr "logarytm o podstawie 10"

msgctxt "ComputeColumnWindow|"
msgid "logarithm of y in 'base'"
msgstr "logarytm o podstawie y"

msgctxt "ComputeColumnWindow|"
msgid "exponential"
msgstr "wykładniczy"

msgctxt "ComputeColumnWindow|"
msgid ""
"Fisher's Z-transform (i.e., the inverse hyperbolic tangent) to transform "
"correlations, numbers between -1 and 1 to the real line"
msgstr ""
"Transformacja Z-Fishera (czyli area tangens hiperboliczny) do "
"przekształcania wartości korelacji, czyli liczb między -1 a 1, na oś "
"rzeczywistą"

msgctxt "ComputeColumnWindow|"
msgid ""
"Inverse Fisher's Z-transform (i.e., the hyperbolic tangent) to transform "
"real numbers to numbers between -1 and 1"
msgstr ""
"Odwrotna transformacja Z-Fishera (czyli tangens hiperboliczny) do "
"przekształcania liczb rzeczywistych na liczby z zakresu od -1 do 1"

msgctxt "ComputeColumnWindow|"
msgid "break your data up in numBreaks levels"
msgstr "dzielenie danych na poziomy zdefiniowane przez numBreaks"

msgctxt "ComputeColumnWindow|"
msgid "replace any missing values (NA) in column by the value in replaceWith"
msgstr "zastąp brak danych (NA) w kolumnie wartością z replaceWith"

msgctxt "ComputeColumnWindow|"
msgid "if-else statement"
msgstr "instrukcja if-else"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Gaussian distribution with specified mean and standard "
"deviation sd"
msgstr ""
"generuje dane z rozkładu Gaussa o określonej średniej i odchyleniu "
"standardowym"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from t distribution with degrees of freedom df and non-"
"centrality parameter ncp"
msgstr ""
"generuje dane z rozkładu t o stopniach swobody df i parametrem "
"niecentralności ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a chi-squared distribution with degrees of freedom df "
"and non-centrality parameter ncp"
msgstr ""
"generuje dane z rozkładu chi-kwadrat o stopniach swobody df i parametrem "
"niecentralności ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from an F distribution with specified degrees of freedoms "
"df1, df2 and non-centrality parameter ncp"
msgstr ""
"generuje dane z rozkładu F o określonych stopniach swobody df1 i df2 oraz "
"parametrze niecentralności ncp"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a binomial distribution with specified trials and "
"probability prob"
msgstr ""
"generuje dane z rozkładu dwumianowego z określonymi próbami i "
"prawdopodobieństwem (prob)"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a negative binomial distribution with specified trials "
"and probability prob"
msgstr ""
"generuje dane z ujemnego rozkładu dwumianowego z określonymi próbami i "
"prawdopodobieństwem (prob)"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a geometric distribution with specified probability prob"
msgstr ""
"generuje dane z rozkładu geometrycznego o określonym prawdopodobieństwie "
"(prob)"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a Poisson distribution with specified rate lambda"
msgstr "generuje dane z rozkładu Poissona z określonym parametrem lambda"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a beta distribution with specified shapes alpha and beta"
msgstr "generuje dane z rozkładu beta o określonych kształtach alfa i beta"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a uniform distribution between min and max"
msgstr "generuje dane z rozkładu jednostajnego pomiędzy wartościami min a max"

msgctxt "ComputeColumnWindow|"
msgid "generates data from a gamma distribution with specified shape and scale"
msgstr "generuje dane z rozkładu gamma o określonym kształcie i skali"

msgctxt "ComputeColumnWindow|"
msgid "generates data from an exponential distribution with specified rate"
msgstr "generuje dane z rozkładu wykładniczego o określonym parametrze"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a log-normal distribution with specified logarithmic "
"mean meanLog and standard deviation sdLog"
msgstr ""
"generuje dane z rozkładu logarytmiczno-normalnego o określonej średniej "
"logarytmicznej (meanLog) i odchyleniu standardowym (sdLog)"

msgctxt "ComputeColumnWindow|"
msgid ""
"generates data from a Weibull distribution with specified shape and scale"
msgstr "generuje dane z rozkładu Weibulla o określonym kształcie i skali"

