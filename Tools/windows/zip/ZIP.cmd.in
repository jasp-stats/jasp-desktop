rem This file is generated from Tools/windows/zip/ZIP.cmd.in, if you want to change it, be aware 
rem that it will be overwritten. You can edit the template file, and rerun the CMake
rem to see your changes here.
rem
rem You don't need to run this file manually, you can ask CMake to run it for you using 
rem `cmake --build . --target zip`

rem @echo off
rem autorun
setlocal EnableDelayedExpansion

rem ---------------------- Packing -------------------------------

echo Making zip-version of installer
where /q zip
IF ERRORLEVEL 1 (
powershell Compress-Archive -Update "@JASP_INSTALL_DIR_NATIVE@\*" "@JASP_BINARY_DIR_NATIVE@\JASP\JASP.zip"
) ELSE (
rem Using gnu zip
pushd .
cd /d "@JASP_INSTALL_DIR_NATIVE@\*" 
zip -9 -q -r "@JASP_BINARY_DIR_NATIVE@\JASP\JASP.zip" . 
popd
)
endlocal

rem ---------------------- Sanity check -------------------------------

rem Fail the target when the shipped tree exploded into the zip (jasp-issues #4586):
rem limits are CMake-configurable via ZIP_MAX_ENTRIES and ZIP_MAX_SIZE_GB.
powershell -NoProfile -ExecutionPolicy Bypass -File "@CMAKE_SOURCE_DIR@\Tools\windows\zip\check-zip.ps1" -ZipPath "@JASP_BINARY_DIR_NATIVE@\JASP\JASP.zip" -MaxEntries @ZIP_MAX_ENTRIES@ -MaxSizeGB @ZIP_MAX_SIZE_GB@

