<?xml version="1.0" encoding="UTF-8"?>

<!-- Static MakePri configuration for the MSIX packages.
     This file replaces the priconfig generated by "makepri createconfig" because
     newer Windows SDKs (26100+) generate one that omits the schema from the main
     resources.pri (omitSchemaFromResourcePacks), which the Store rejects for
     single-package submissions:
       "Can't read resources.pri ... generated with the omitSchemaFromResourcePacks
        option and no other resources.pri with schema was provided to resolve it."

     Two deliberate differences from the generated default:
     - there is NO <packaging> element at all: no autoResourcePackage splitting, so
       every candidate lands in one schema-carrying resources.pri (an *empty*
       <packaging></packaging> is treated as invalid config by makepri, which then
       falls back to its defaults).
     - there is no <indexer-config type="PRI"/>: the Install folder keeps its
       resources.pri between builds/variants and re-indexing it merges stale (and
       previously schema-less or language-split) pri data into every new package.

     Defaults mirror "makepri createconfig /dq en-US" output. -->

<resources targetOsVersion="10.0.0" majorVersion="1">

	<index root="\" startIndexAt="\">
		<default>
			<qualifier name="Language" value="en-US"/>
			<qualifier name="Contrast" value="standard"/>
			<qualifier name="Scale" value="100"/>
			<qualifier name="HomeRegion" value="001"/>
			<qualifier name="TargetSize" value="256"/>
			<qualifier name="LayoutDirection" value="LTR"/>
			<qualifier name="Theme" value="dark"/>
			<qualifier name="AlternateForm" value="UNPLATED"/>
			<qualifier name="DXFeatureLevel" value="DX9"/>
			<qualifier name="Configuration" value=""/>
			<qualifier name="DeviceFamily" value="Universal"/>
		</default>
		<indexer-config type="folder" foldernameAsQualifier="true" filenameAsQualifier="true" qualifierDelimiter="."/>
		<indexer-config type="resw" convertDotsToSlashes="true" initialPath=""/>
		<indexer-config type="resjson" initialPath="Resources"/>
	</index>

	<!--<index>
		<indexer-config type="priinfo" emitStrings="true" emitPaths="true" emitEmbeddedData="true"/>
	</index>-->

</resources>
